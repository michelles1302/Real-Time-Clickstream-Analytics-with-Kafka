# Application Environment (local or production)
APP_ENV=local

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=clickstream
KAFKA_GROUP_ID=clickstream-consumer

# Generator Settings
EVENTS_PER_SECOND=5

# Batch Processing Settings
BATCH_SIZE=100
BATCH_TIMEOUT_SECONDS=10

# Storage Mode (local or s3)
STORAGE_MODE=local

# AWS S3 Storage Settings (Required if STORAGE_MODE=s3)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-clickstream-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
